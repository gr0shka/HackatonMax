# AI selection and ordering of route POIs (required for OpenRouter mode)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
YANDEX_MAPS_API_KEY=

# Live places catalog. Without it the backend uses imported OSM/PostGIS data.
TWOGIS_API_KEY=

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=route_optimizer
POSTGRES_PORT=5432
DATABASE_URL=postgres://postgres:postgres@postgres:5432/route_optimizer?sslmode=disable

# Service URLs and timeouts
ML_BASE_URL=http://ml-service:8001
ML_SERVICE_URL=http://ml-service:8001
ML_TIMEOUT=8s
OSRM_BASE_URL=https://routing.openstreetmap.de/routed-foot
OSRM_URL=https://routing.openstreetmap.de/routed-foot
